# MateClaw server deployment environment.
# Copy this file to docker/.env and replace every generated secret before first start.

TZ=Asia/Shanghai

# Public address used by browsers and desktop clients.
# Examples:
#   https://mateclaw.example.com
#   http://203.0.113.10:18080
MATECLAW_PUBLIC_URL=http://192.168.0.50:18080
MATECLAW_HTTP_PORT=18080

# Database
DB_NAME=mateclaw
DB_USERNAME=mateclaw
DB_PASSWORD=swgMpKbZjT2UV3WCO8On6OX78k/YJMIJHVf1YrsAOCv5Ovyo+Gc3cL3bBt6jqPOs
DB_ROOT_PASSWORD=ZgDpt5vwYZRlcJpNlD8J3gOJGBrdfuNsJGKQvEtPg3Ql4UD0flKx2eCI7zcPpxIm

# Security
JWT_SECRET=GGCLtpNH7OBudnXlCCrzm6RuHesEamBB7XXeqFJymxT8Lk9yseavAR39hg+pZ88X
JWT_EXPIRATION=2592000000
JWT_RENEWAL_THRESHOLD=604800000

# Restrict CORS in production. For Electron-only use, keep the public URL here.
# For web access through a domain, use: https://mateclaw.example.com
MATECLAW_CORS_ALLOWED_ORIGINS=http://192.168.0.50:18080

# Search sidecar
SEARXNG_SECRET=1d1b450892c27441550408ec7e4b740c35faac8b4c54ae67988b72d803568d0e
SEARXNG_UWSGI_WORKERS=2
SEARXNG_UWSGI_THREADS=4

# Optional model/search keys.
# The preferred product flow is to configure model providers in the admin UI after login.
DASHSCOPE_API_KEY=
SERPER_API_KEY=

# Maven build acceleration for mainland China.
#MAVEN_FLAGS=-Paliyun-first

# Browser automation overrides. Leave empty for the bundled Playwright browser.
MATECLAW_BROWSER_CDP_URL=
MATECLAW_BROWSER_CHROME_PATH=
MATECLAW_BROWSER_CHANNEL=

# JVM/container tuning.
MATECLAW_SHM_SIZE=2gb
JAVA_TOOL_OPTIONS=-Duser.timezone=Asia/Shanghai -Xms512m -Xmx2g
